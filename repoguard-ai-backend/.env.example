# GitHub App -> General -> App ID
GITHUB_APP_ID=123456
# Keep the downloaded PEM outside the repository, for example: /Users/you/secrets/repoguard.private-key.pem
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
# GitHub App -> General -> Webhook secret
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
# DeepSeek Platform -> API Key
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
# Strong random API token to protect private repo reports. Do NOT use NEXT_PUBLIC_ for this.
DASHBOARD_TOKEN=replace-with-a-long-random-token
# Local demo defaults
DATABASE_PATH=./repoguard.db
ALLOWED_ORIGINS=http://localhost:3000
# Per-request budget controls
MAX_PR_FILES=120
MAX_REPO_SOURCE_FILES=12
