# GitHub App (General -> App ID; not OAuth client ID)
GITHUB_APP_ID=123456
# Absolute path to a private key stored outside Git (never upload PEM)
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-real-webhook-secret
# DeepSeek API key
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-flash
# Long random secret used only by the Next.js server in local dev
DASHBOARD_TOKEN=replace-with-a-random-32-plus-character-token
DATABASE_PATH=./repoguard.db
ALLOWED_ORIGINS=http://localhost:3000
MAX_PR_FILES=120
MAX_REPO_SOURCE_FILES=12
