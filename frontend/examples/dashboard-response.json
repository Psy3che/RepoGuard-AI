      "risk_level": "HIGH",
      "merge_decision": "REVIEW_REQUIRED",
      "summary": "The verification contract changes from a boolean to an object. Several callers may still assume the old type, putting authorization paths at risk.",
      "files_changed": 4,
      "additions": 82,
      "deletions": 19,
      "affected_module_ids": [
        "auth",
        "payments",
        "orders",
        "gateway"
