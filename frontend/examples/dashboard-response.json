          "file": "src/core/auth.ts",
          "line": 42,
          "severity": "HIGH",
          "status": "SUSPECTED",
          "title": "Authentication return contract changed",
          "explanation": "The new object return value is different from the former boolean contract. Call sites in payment and order services should be verified.",
          "recommendation": "Update dependent call sites or preserve the original API contract; then run integration tests."
        },
        {
          "id": "f-128-2",
          "file": "src/services/payment.ts",
          "line": 87,
          "severity": "MEDIUM",
          "status": "SUSPECTED",
          "title": "Potential truthiness regression",
          "explanation": "A caller checks the result directly as a boolean. An object is truthy even when its `valid` property is false.",
          "recommendation": "Check `result.valid` explicitly and cover invalid tokens with a regression test."
        }
      ],
      "diff": [
